# ============================================================
#  Configuration d'Amadeus
#  Copie ce fichier en « .env » (l'installateur le fait pour toi et te demande
#  tes clés). Ne partage jamais ton .env : il contient tes clés API.
# ============================================================

# === Cerveau principal : GLM (obligatoire) ===
# Clé API : https://z.ai (international) ou https://open.bigmodel.cn (Chine)
GLM_API_KEY=colle-ta-cle-ici
# Adresse selon ton compte :
#   z.ai international         : https://api.z.ai/api/paas/v4
#   bigmodel.cn, compte crédité : https://open.bigmodel.cn/api/paas/v4
#   bigmodel.cn, Coding Plan    : https://open.bigmodel.cn/api/coding/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# glm-5.3 = meilleur jeu de rôle ; glm-4.6 = plus rapide
GLM_MODEL=glm-5.3
# Coupe la « réflexion » des GLM récents : ~2 s au lieu de 10+ avant le premier mot
GLM_DISABLE_THINKING=true

# === Cerveau rapide : GPT-OSS 120B chez Groq (facultatif) ===
# Clé gratuite sur https://console.groq.com — choix du cerveau dans l'interface
# (Réglages > Cerveau). Quota gratuit dépassé → le message part sur GLM.
GROQ_API_KEY=
# Cerveau au tout premier lancement : glm ou gptoss
BRAIN=glm

# === Voix (TTS) ===
# Serveur GPT-SoVITS local (voix de Kurisu)
TTS_GPTSOVITS_URL=http://127.0.0.1:9880
# Voix de secours (edge-tts) si GPT-SoVITS est éteint
TTS_FALLBACK_VOICE=ja-JP-NanamiNeural
# Streaming : 3 = régulier, sans blanc en pleine phrase (conseillé) ; 0 = désactivé
TTS_STREAMING_MODE=3
# Stabilité (plus bas = moins de mots avalés, mais plus monotone)
TTS_TEMPERATURE=0.7
TTS_TOP_K=5
TTS_TOP_P=0.9
# Volume cible (dB) : toutes les émotions sont ramenées au même niveau
TTS_LOUDNESS_DB=-16
# Référence neutre : par défaut celle de l'installation (tts-server/kurisu/emotions/refs.json).
# Pour en essayer une autre : chemin du .wav + sa transcription exacte.
# TTS_REF_AUDIO=../tts-server/kurisu/ref.wav
# TTS_REF_TEXT=

# === Oreilles (STT, Whisper) ===
# large-v3-turbo = rapide et précis (conseillé) ; medium ; small (machines modestes)
STT_MODEL=large-v3-turbo
# auto = carte graphique si possible, sinon processeur
STT_DEVICE=auto
# auto = détection de la langue ; fr = plus fiable si tu parles toujours français
STT_LANGUAGE=auto
# Charge Whisper au démarrage (sinon ~10 s d'attente au premier appui micro)
STT_PRELOAD=true

# === Divers ===
DATA_DIR=../data
BACKEND_PORT=8642
